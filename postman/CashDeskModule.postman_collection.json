            },
            {
              "key": "dateTo",
              "value": "2025-05-02T23:59:59Z"
            }
          ]
        },
        "description": "Gets historical balance for MARTINA between May 1 and May 2, 2025"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "[\n  {\n    \"cashierName\": \"MARTINA\",\n    \"balances\": {\n      \"BGN\": {\n        \"currency\": \"BGN\",\n        \"denominations\": {\"10\": 50, \"50\": 10},\n        \"total\": 1000\n      },\n      \"EUR\": {\n        \"currency\": \"EUR\",\n        \"denominations\": {\"20\": 50, \"100\": 10},\n        \"total\": 2000\n      }\n    }\n  }\n]"
