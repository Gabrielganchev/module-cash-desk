            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cash-balance?cashier=MARTINA&dateFrom=2025-05-01T00:00:00Z&dateTo=2025-05-02T23:59:59Z",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cash-balance"],
          "query": [
