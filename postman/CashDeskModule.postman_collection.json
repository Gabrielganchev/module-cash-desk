{
  "info": {
    "name": "CashDeskModule",
    "_postman_id": "c3b5f8e4-9f2d-4e1a-8c7a-5d6e7f8a9b0c",
    "description": "Postman collection for Cash Desk Module API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Deposit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "FIB-X-AUTH",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cashierName\": \"MARTINA\",\n    \"operationType\": \"DEPOSIT\",\n    \"currency\": \"BGN\",\n    \"denominations\": {\"10\": 5, \"50\": 1}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cash-operation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cash-operation"]
        },
        "description": "Deposits 100 BGN (5x10 + 1x50) for MARTINA"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "\"Operation successful\""
        }
      ]
    },
    {
      "name": "Withdraw",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "FIB-X-AUTH",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"cashierName\": \"MARTINA\",\n    \"operationType\": \"WITHDRAWAL\",\n    \"currency\": \"EUR\",\n    \"denominations\": {\"20\": 5}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/cash-operation",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cash-operation"]
        },
        "description": "Withdraws 100 EUR (5x20) for MARTINA"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "\"Operation successful\""
        }
      ]
    },
    {
      "name": "Get Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "FIB-X-AUTH",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cash-balance?cashier=MARTINA",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cash-balance"],
          "query": [
            {
              "key": "cashier",
              "value": "MARTINA"
            }
          ]
        },
        "description": "Gets current balance for MARTINA"
      },
      "response": [
        {
          "name": "Success",
          "status": "OK",
          "code": 200,
          "body": "[\n  {\n    \"cashierName\": \"MARTINA\",\n    \"balances\": {\n      \"BGN\": {\n        \"currency\": \"BGN\",\n        \"denominations\": {\"10\": 50, \"50\": 10},\n        \"total\": 1000\n      },\n      \"EUR\": {\n        \"currency\": \"EUR\",\n        \"denominations\": {\"20\": 50, \"100\": 10},\n        \"total\": 2000\n      }\n    }\n  }\n]"
        }
      ]
    },
    {
      "name": "Get Historical Balance",
      "request": {
        "method": "GET",
